root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,md}]
indent_size = 2

[*.ps1]
indent_size = 2

# Inno Setup and the plain-text files the installer ships read as CRLF on
# Windows; leave their endings alone.
[*.{iss,txt}]
end_of_line = crlf
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
